# Copia este archivo a .env y completa. NUNCA subas .env a GitHub.
SENACE_API_KEY=
SENACE_URL=https://datosabiertos.senace.gob.pe/Api/datastreams/CarteraProyectos
SENAMHI_PACKAGE_URL=https://www.datosabiertos.gob.pe/api/3/action/package_show?id=b884a001-f444-4c87-91b2-bee1891e6eb7
# Vacío = caché en memoria. Con Redis: redis://localhost:6379/0
REDIS_URL=
HTTP_TIMEOUT_SECONDS=3.5
HTTP_MAX_RETRIES=2
CACHE_TTL_SECONDS=3600

# Configuración del Gateway
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Autenticación JWT
JWT_REQUIRED=false
JWT_SECRET=

# Orígenes permitidos para CORS
# Reemplazar por los dominios autorizados antes de producción
CORS_ORIGINS=["http://localhost:5500"]
